location ^~ /api/auth/0.1/backends {
    proxy_pass http://wazo-auth/0.1/backends;
    include /etc/nginx/wazo-auth-shared.conf;
    include /etc/nginx/wazo-no-auth-shared[.]conf;
}

location ^~ /api/auth/0.1/status {
    proxy_pass http://wazo-auth/0.1/status;
    include /etc/nginx/wazo-auth-shared.conf;
    include /etc/nginx/wazo-no-auth-shared[.]conf;
}

location ^~ /api/auth/0.1/saml {
    proxy_pass http://wazo-auth/0.1/saml;
    include /etc/nginx/wazo-auth-shared.conf;
    include /etc/nginx/wazo-no-auth-shared[.]conf;
}

location ^~ /api/auth/ {
    # Not authenticated: metrics are only served on 127.0.0.1:9497
    location = /api/auth/0.1/metrics {
        deny all;
    }

    proxy_pass http://wazo-auth/;
    include /etc/nginx/wazo-auth-shared.conf;
}
